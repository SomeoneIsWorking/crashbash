// Crash Bash resident recompiler seeds.
//
// emit.py already roots discovery in this executable's entry point and binary pointer/table scan,
// then follows direct jal edges. Grow `main` only from an observed [recomp-MISS] whose call site is
// recorded; the sole entry below meets that evidence gate.
{
  "main": [
    // First live boot boundary: Hle::irqPoll consulted the SysEnq verifier stored at 0x8006D98C
    // while guest CD sync 0x8003EDBC called VSync 0x800320EC. Ghidra confirms 0x8003B1BC is that
    // verifier; static discovery could not see the guest-RAM function pointer.
    "0x8003B1BC",
    // Second live boundary, reached only after the BOOT scene advances (~frame 256+ of a 600-frame
    // run): [recomp-MISS 0] no recompiled fn for 0x80012678, caller ra=0x80012428, a0=0x801CFB88.
    // The retail instruction at 0x80012420 is `jalr $v0` with the target loaded from an object
    // field, so static discovery cannot see it; 0x80012678 is a real entry (addiu sp,sp,-0x38 then
    // sw s7/ra/s6..s0). Live chain: 0x80092BA0 -> 0x8001E610 -> ov_boot 0x80093BE8 -> 0x80093588
    // -> 0x8001231C -> here.
    "0x80012678",
    // Third live boundary: libmcrd registers its interrupt-mode card-event completion callback via
    // OpenEvent(EV_MD_INTR); the host HLE event table owns the address, so it is never stored in
    // guest RAM as a word and no pointer scan can see it. Guest-side construction measured at
    // 0x80047280: `addiu a3, a3, 0x718C` (base 0x80040000 from the preceding lui) builds the
    // callback passed to the A-function, and the live [recomp-MISS 0] fired from
    // Hle::deliverEvent -> 0x8004718C during the first boot-frame card probe. 0x8004718C is a real
    // stackless entry (`addiu v0,zero,1`) preceded by the previous function's `jr ra` plus padding.
    "0x8004718C",
    // Fourth live boundary: the computed dispatch at 0x80012420 (`jalr $v0`, target loaded from
    // object field s0+0x14) reached its next method. [recomp-MISS 0] no recompiled fn for
    // 0x80016F34, caller ra=0x80012428, a0=0x801D4B58, c->pc=0x80027944, after the EUROCOM logo
    // state advances (~frame 300+). Real entry (addiu sp,sp,-0x18 prologue, preceded by the prior
    // function's jr ra). Its pointer slot at 0x8005064C holds 0 in the FILE and 0x80016F34 in
    // runtime RAM — the game patches it during init, so neither pointer_table_funcs nor any
    // static scan can see it.
    "0x80016F34",
    // Fifth live boundary: the same computed dispatch at 0x80012420 (`jalr $v0`, target from
    // object field s0+0x14) reached its next method after the key→ord carrier fix let the flow
    // run past frame ~840. [recomp-MISS 0] no recompiled fn for 0x8001DFF8, caller ra=0x80012428,
    // a0=0x801DAB70, c->pc=0x80027944. Real entry (addiu sp,sp,-0x20, preceded by jr ra; its
    // pointer is runtime-patched like the fourth boundary's).
    "0x8001DFF8",
    // Sixth live boundary: the 0x80012420 computed-dispatch family again (ra=0x80012428), now with
    // a0=0x80196A38, after MENU2 provisioning let the flow run on. Real entry (addiu sp,sp,-0x30,
    // preceded by jr ra; delay 27BD0038).
    "0x80012840"
  ],
  // ResetCallback's custom interrupt exit resumes the nonzero setjmp path at 0x80031AE8.  The
  // runtime trace reached ResetCallback 0x80031A80 and registered source 2 -> 0x8003F5F0; the
  // retail instruction at 0x80031AE0 is `jal 0x8003ACEC` (setjmp), so call+8 is the measured
  // resume PC.  main_reentry is the authoritative seed class: psxport unions it into discovery,
  // emits the dispatchable body, and preserves fallthrough across the artificial split.
  "main_reentry": ["0x80031AE8"],
  "overlay_bases": {
    // The first CRASHBSH.DAT module is the final 189 sectors of the file. The live CD trace writes
    // LBA 35799 first to 0x80078C90 and LBA 35987 last to 0x800D6C90, establishing the fixed load
    // range [0x80078C90, 0x800D7490). Its first word is the dispatcher entry 0x80092BDC.
    "BOOT": "0x80078C90",
    // The BOOT module requests 16 DAT sectors after entering its menu state. Live DMA writes LBA
    // 28178 first to 0x800B32B4 and LBA 28193 last to 0x800BAAB4, replacing this nested code range.
    "MENU": "0x800B32B4",
    // A SECOND module in the same nested slot, read over MENU once the attract flow leaves the
    // menu: `38 sector(s) from LBA 28272 to 0x800B32B4` (crashbash-cd trace 2026-08-29). MENU and
    // this image are alternatives, never co-resident; the router tells them apart by signature.
    // Named by disc LBA, not role: 0x800C3434 registers a behavior vtable at 0x8005AA70 and the
    // image's name table is animation states (BREATHE/JUMP/DAZED/WIN/TAZING) rather than MENU's
    // front-end text, which rules OUT "second menu phase" but does not establish what it is.
    // Byte-verified: the miss RAM dump over [0x800B32B4,0x800C5BFC) equals DAT [0x36C2000,0x36D4948)
    // exactly, and sectors 0..36 of the 38 diff to zero. Note 0x800C3434 IS valid R3000A once
    // loaded (27BDFFE8 addiu sp,sp,-0x18); issue 0017's "opcode 0x3F invalid" read BOOT's FILE
    // bytes, not this image, so the miss was "module not provisioned", never a decode failure.
    "DAT28272": "0x800B32B4",
    // A THIRD module in the nested slot: `31 sector(s) from LBA 28241 to 0x800B32B4`
    // (crashbash-cd trace 2026-08-29), loaded immediately before recomp-MISS 0x800C0B94
    // (caller ra=0x80078D10, the same dispatch site as DAT28272's 0x800C3434). The miss RAM
    // dump over the slot matches this image except the runtime-patched pointer slots, and
    // 0x800C0B94 (image offset 0xD8E0) decodes as valid R3000A (lui v1,0x8006 / lui v0,0x800B).
    // Its name table is animation states too (BREATHE/BANK/IDLE_A/TAUN...), so it is the same
    // family as DAT28272, provisionally another attract demo scene.
    "DAT28241": "0x800B32B4"
  },
  "overlay_base_patterns": [],
  "overlay_seeds": {
    // Resident dispatcher 0x80010410 indirect-calls the module's first pointer after the load. The
    // post-load RAM dump and raw module independently agree that this pointer is 0x80092BDC.
    "BOOT": ["0x80092BDC"],
    // After the second read, object callback 0x8001E610 reads 0x800B5244 from the MENU image's raw
    // function table at 0x800B9524. The fail-fast dispatch trace proves this callback is invoked.
    "MENU": ["0x800B5244"]
  }
}
